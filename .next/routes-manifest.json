      "page": "/dm/[conversationId]",
      "regex": "^/dm/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPconversationId": "nxtPconversationId"
      },
      "namedRegex": "^/dm/(?<nxtPconversationId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/profile/[userId]",
      "regex": "^/profile/([^/]+?)(?:/)?$",
