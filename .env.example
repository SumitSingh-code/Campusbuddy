# Campus Wall — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project URL: found in Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon/public key (safe to expose in frontend)
SUPABASE_ANON_KEY=eyJ...

# Service role key (SECRET — backend only, never expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── App ──────────────────────────────────────────────────────────────────────
# Allowed CORS origin for the Express API
# On Vercel, this will be your Vercel deployment URL or custom domain
FRONTEND_URL=https://your-project.vercel.app

# ─── Notes ────────────────────────────────────────────────────────────────────
# For local development:
#   1. Run `npm run dev` to start Express on port 3000
#   2. Open public/auth.html directly in browser (or use a local static server)
#   3. Update public/js/config.js with your Supabase URL and ANON key
#
# For Vercel deployment:
#   1. Add all vars above in Vercel Dashboard → Project → Settings → Environment Variables
#   2. The SUPABASE_SERVICE_ROLE_KEY goes in "Production" only (not Preview)
#
# Supabase free tier keep-alive:
#   Set up a GitHub Actions cron job to ping GET /api/health every 5 days
#   to prevent the project auto-pausing after 7 days of inactivity
